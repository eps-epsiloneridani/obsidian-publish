# =============================================================================
# config.example.env — template for config.env (GITIGNORED, chmod 600)
# =============================================================================
# Copy this file to config.env in the same directory and edit the values. Every
# value here is specific to the machine that runs the pipeline and the host it
# deploys to. Nothing in this file is committed; config.env is the single source
# of truth that deploy.sh (and setup.sh) read at run time.
#
# Paths must be ABSOLUTE. Leave a value empty to disable the associated step.
# =============================================================================

# --- Source vault ------------------------------------------------------------
# Absolute path to the Obsidian vault root (the folder that CONTAINS the publish
# scope, e.g. .../vault/web). deploy.sh builds this and nothing else.
NOTES_VAULT=/absolute/path/to/your/vault

# Deny-by-default publish scope: a prefix, relative to NOTES_VAULT, under which
# notes are published. Everything outside it is silently excluded, and the
# fail-closed leak check independently re-verifies that no disallowed content
# reached the artifact. Default: web/
NOTES_PUBLISH_SCOPE=web/

# --- Deploy target (rsync) ---------------------------------------------------
# Full rsync destination. For a remote host reached over the restricted deploy
# key this is USER@HOST:PATH, where PATH is relative to the rrsync-forced
# docroot (so "/" means the whole docroot). For a local directory (one-box
# deploys or tests) use an absolute filesystem path instead.
NOTES_RSYNC_TARGET=deploy@notes.example.com:/

# Split form of the target. Only used to compose NOTES_RSYNC_TARGET when it is
# left empty above. Informational otherwise.
NOTES_DEPLOY_USER=deploy
NOTES_DEPLOY_HOST=notes.example.com

# Absolute path to the deploy SSH private key (ed25519). Only required when
# NOTES_RSYNC_TARGET is remote. setup.sh can generate a keypair here (see
# NOTES_GENERATE_DEPLOY_KEY below).
NOTES_SSH_KEY=/absolute/path/to/.ssh/id_ed25519_deploy

# Remote docroot that the rsync target's "/" maps to (via rrsync). Used by
# setup.sh when it prints the authorized_keys line and nginx steps.
NOTES_DOCROOT=/var/www/notes

# --- setup.sh behaviour ------------------------------------------------------
# If "true", setup.sh generates an ed25519 keypair at NOTES_SSH_KEY
# (id_ed25519_deploy + .pub) and prints the public key for the
# authorized_keys step. If "false" (default), setup.sh never creates or touches
# keys.
NOTES_GENERATE_DEPLOY_KEY=false
