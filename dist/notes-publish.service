# One-shot republish pipeline service.
#
# Activated by notes-publish.path on every vault change; can also be started
# manually (`systemctl --user start notes-publish.service`) to force a republish.
# deploy.sh is fail-closed: any error exits non-zero and leaves the target
# docroot untouched. No [Install] section -- this unit is only ever reached via
# the path unit (or a manual start), never enabled standalone.
#
# Estate-agnostic: `%h` is the systemd home-directory specifier (the user who
# runs the unit), so this works for any account as long as the repo is cloned
# to ~/obsidian-publish. All site-specific values (vault path, publish scope,
# rsync target/user/key, docroot) are read by deploy.sh from config.env.

[Unit]
Description=Publish vault publish-scope to the notes static site
# Rapid vault saves fire the path unit repeatedly; flock in deploy.sh makes
# overlapping runs safe, so do not rate-limit starts.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=%h/obsidian-publish/deploy.sh
WorkingDirectory=%h/obsidian-publish

# Sane resource bounds for a tiny stdlib build + one rsync.
MemoryMax=512M
MemoryHigh=384M
Nice=10
TimeoutStartSec=300

# Log deploy.sh stdout/stderr to the journal.
StandardOutput=journal
StandardError=journal
